{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "jsx": "react-native",
    "lib": ["ES2020"],
    "types": ["react", "react-native"],
    "paths": {
      "@/*": ["./src/*"],
      "@unis-plus/shared": ["../../packages/shared/src/index.ts"]
    }
  },
  "include": ["App.tsx", "src/**/*"],
  "exclude": ["node_modules"]
}
